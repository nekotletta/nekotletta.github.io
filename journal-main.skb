(use-modules (skribilo ast)
             (skribilo engine)
             (skribilo source lisp)
             (skribilo index)
             (skribilo package html-navtabs)
             (skribilo package web-book2)
             (skribilo reader))


;;traverse and populate navbar with chapters
(define (html-tabs n e)

      (let ((doc-struct (ast-document n)))
            (map handle
                  (container-search-down (lambda (n)
                        (is-markup? n 'chapter))
                  doc-struct))))

;;override html
(let ((html (find-engine 'html)))
      (if (engine? html)
            (begin
                  (engine-custom-set! html 'html-navtabs-produce-css? #f)
                  (engine-custom-set! html 'head "<meta name='viewport' content='width=device-width, initial-scale=1.0'>")
                  ;;override css
                  (engine-custom-set! html 'css "styles.css")
                  (engine-custom-set! html 'title-foreground "wheat !important")
                  

                  ;;add a navbar, based on chapters in the page
                  (engine-custom-set! html 'html-navtabs html-tabs))))


;;was gonna pick the post based on some list / index
;;but this is not possible since i need to compile everything
(define (go-to-post html-ref text)
      (ref :url (string-append "posts/" html-ref) :text text)
)

(document :title [,(color :fg [#4c2708] [Journal])]

(section :class "sidelines-j" :text [aaa] :number #f)

(section :class "journal-base" :number #f :text [aa]

(subsubsection :class "invisible but-p-container" :title "AA" :number #f :file #f :ident "go-back"
      (p :class "goback-j" [,(ref :url "main.html" :text [,(color :fg [white] [Go back])])]))

(p :class "indented-p" [,(color :fg [#4c2708] [Welcome to my journal! I intend to update this journal every once in a while.
                        The posts will be divided based on the main topic in them, but I admit most will be about coding, or development in general.
                        The topics can be found on the navbar at the top, or by scrolling through the site!] )])
(p [,(color :fg [#4c2708] [You may see me sometimes use some colors in some notes. Here is what they mean:])])
(itemize (item [,(color :bg [#2e55c3] :fg [white] [rgb(46, 85, 195), or #2e55c3 --> used for any link inside the post. Usually used to reference stuff.])])
         (item [,(color :bg [blue] :fg [white] [blue, or #0000FF --> used for specific parts of code I may want to highlight.])]))

